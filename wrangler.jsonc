{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "short-links",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The Worker sees every request first (short links like /promo and the home redirect are Worker routes):
    // otherwise browsers opening /promo would get the 404 page straight from the static files
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "short-links",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
